/*
  Paper (Section 2): "the reactive Euler equations are used as governing
  equations" – inviscid, no turbulence model.
  simulationType laminar is the correct choice for Euler-based simulation.
*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      turbulenceProperties;
}

simulationType  laminar;

