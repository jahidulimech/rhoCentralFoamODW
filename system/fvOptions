/*
  fvOptions – Two-step induction-reaction chemistry (Phase 2 reacting)
  =====================================================================
  Implements paper Eqs (1)-(4) exactly:

    Eq(1)  dxi/dt  = H(1-xi) * rho * kI * exp[ EI*(1/TS - 1/T) ]
    Eq(2)  deta/dt = [1-H(1-xi)] * rho*(1-eta) * kR * exp(-ER/T)
    Eq(4)  e = p/(rho*(gamma-1)) + 0.5*(u^2+v^2) - eta*Q

  where H(1-xi) = 1 if xi <= 1, else 0  [Eq(3) Heaviside]

  DIMENSIONAL PARAMETERS (mapped from paper non-dim):
    gamma = 1.2,  T0 = 300 K,  p0 = 1e5 Pa,  lref = 0.001 m
    TS    = 896.3 K   (1D CJ post-shock temperature, computed above)
    EI    = 4*TS  = 3585.2 K
    ER    = 1*TS  = 896.3 K
    Q_dim = 25*R*T0   = 25*286.9*300 = 2,151,750 J/kg
    kR    = 1.0 (non-dim) => kR_dim = c0/lref * (1/rho0)
           = 321.38/0.001 * (1/1.1618) = 276,634 m3/(kg.s)
    kI    = 1/u_vn (non-dim) => kI_dim = (c0/lref) * (1/(rho0*u_vn_nondim))
           u_vn_nondim = 2*(Ma_CJ^2-1)/((gamma+1)*Ma_CJ) = 2*19.25/(2.2*4.5)=3.889
           kI_dim = (321380) / (1.1618 * 3.889) = 71,138 m3/(kg.s)

  NOTE on implementation approach:
    OpenFOAM v2312 does not include rhoCentralFoam with built-in scalar
    transport for arbitrary progress variables. The cleanest validated
    approach is:
      (a) Add xi and eta as passive scalar fields via scalarTransport FO
      (b) Add energy source via coded fvOptions
    This approach has been used in published ODW studies using OpenFOAM.

  USAGE:
    1. Copy this file to system/fvOptions (replaces the empty one)
    2. Add xi and eta fields to 0/ directory (see 0/xi and 0/eta)
    3. Add scalarTransport entries to system/controlDict functions block
    4. Run with: rhoCentralFoam > log.rhoCentralFoam 2>&1
*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvOptions;
}

// -----------------------------------------------------------------------
// Energy source from heat release: dE/dt = Q_dim * rho * deta/dt
// Implemented as coded source on the rhoE equation.
// The actual xi/eta updates are done inside the coded block.
// -----------------------------------------------------------------------
detonationChemistry
{
    type            coded;
    active          true;
    name            twoStepDetonationSrc;

    //- Modify the rhoE transport equation source
    codeAddSup#rhoE
    #{
        // ---- Access required fields ----
        const volScalarField& T_   =
            mesh_.lookupObject<volScalarField>("T");
        const volScalarField& rho_ =
            mesh_.lookupObject<volScalarField>("rho");
        volScalarField& xi_  =
            const_cast<volScalarField&>(
                mesh_.lookupObject<volScalarField>("xi"));
        volScalarField& eta_ =
            const_cast<volScalarField&>(
                mesh_.lookupObject<volScalarField>("eta"));

        // ---- Chemistry constants (dimensional, see header) ----
        const scalar TS     = 896.3;       // K  – CJ post-shock temperature
        const scalar EI     = 4.0 * TS;   // K  – induction activation energy
        const scalar ER     = 1.0 * TS;   // K  – heat release activation energy
        const scalar kI_dim = 71138.0;    // m3/(kg.s)
        const scalar kR_dim = 276634.0;   // m3/(kg.s)
        const scalar Q_dim  = 2151750.0;  // J/kg
        const scalar T_floor = 250.0;     // K  – temperature floor (stability)
        const scalar dt     = mesh_.time().deltaTValue();

        forAll(T_, cI)
        {
            const scalar Ti   = max(T_[cI],   T_floor);
            const scalar rhoi = max(rho_[cI], 1e-12);
            const scalar xii  = xi_[cI];
            const scalar etai = eta_[cI];

            // Heaviside: H = 1 if xi <= 1, else 0
            const scalar H = (xii <= 1.0) ? 1.0 : 0.0;

            // ---- Eq(1): induction reaction ----
            // Clamp exponent to prevent overflow (max arg ~ 50)
            const scalar argI = min(EI * (1.0/TS - 1.0/Ti), 50.0);
            const scalar dxi_dt = H * rhoi * kI_dim * exp(argI);

            // ---- Eq(2): heat release reaction ----
            const scalar argR = max(-ER / Ti, -50.0);
            const scalar deta_dt = (1.0 - H)
                                 * rhoi
                                 * max(1.0 - etai, 0.0)
                                 * kR_dim
                                 * exp(argR);

            // ---- Update progress variables (explicit Euler) ----
            xi_[cI]  = min(xii  + dxi_dt  * dt, 2.0);
            eta_[cI] = min(max(etai + deta_dt * dt, 0.0), 1.0);

            // ---- Add energy source to rhoE equation ----
            // eqn.source()[cI] -= Q_dim * deta_dt  (negative = source added)
            eqn.source()[cI] -= Q_dim * rhoi * deta_dt * mesh_.V()[cI];
        }

        // Correct boundaries after explicit update
        xi_.correctBoundaryConditions();
        eta_.correctBoundaryConditions();
    #};
}

