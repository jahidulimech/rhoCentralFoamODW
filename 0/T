/*
  Temperature field – T0 = 300 K
  Paper: "CJ velocity of stoichiometric hydrogen-air mixture (100 kPa and 300 K)"

  wedge_wall: zeroGradient (adiabatic slip wall for Euler equations)
*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}

dimensions      [ 0 0 0 1 0 0 0 ];   // K

internalField   uniform 300;

boundaryField
{
    inlet
    {
        type    fixedValue;
        value   uniform 300;
    }
    outlet
    {
        type    zeroGradient;
    }
    top
    {
        type    zeroGradient;
    }
    wedge_wall
    {
        type    zeroGradient;
    }
    frontAndBack
    {
        type    empty;
    }
}

