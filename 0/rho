/*
  Density field (primary variable for rhoCentralFoam)
  rho0 = p0 / (R * T0) = 100000 / (286.9 * 300) = 1.1618 kg/m3
*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      rho;
}

dimensions      [ 1 -3 0 0 0 0 0 ];   // kg/m3

internalField   uniform 1.1618;

boundaryField
{
    inlet
    {
        type    fixedValue;
        value   uniform 1.1618;
    }
    outlet
    {
        type    zeroGradient;
    }
    top
    {
        type    zeroGradient;
    }
    wedge_wall
    {
        type    zeroGradient;
    }
    frontAndBack
    {
        type    empty;
    }
}

